      "clause": "5.3.4",
      "pdfPage": 34,
      "printedPage": 28,
      "summary": "痞塊。"
    },
    "EX-B7": {
      "clause": "5.3.5",
      "pdfPage": 34,
      "printedPage": 28,
      "summary": "腰痛。"
    },
    "EX-B8": {
      "clause": "5.3.6",
      "pdfPage": 34,
      "printedPage": 28,
      "summary": "腰骶痛、下肢癱瘓、月經不調。"
    },
    "EX-UE1": {
