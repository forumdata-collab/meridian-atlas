    "EX-B2": {
      "clause": "5.3.2",
      "pdfPage": 34,
      "printedPage": 28,
      "summary": "上胸段對應心肺及上肢病症；下胸段對應肝、膽、脾、胃腸病症；腰段對應腰腹及下肢病症。"
    },
    "EX-B3": {
      "clause": "5.3.3",
